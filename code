# ============================================================
# SAFE CALCULATOR
# ============================================================

OPERATORS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.Mod: operator.mod,
    ast.USub: operator.neg,
    ast.UAdd: operator.pos,
}


def calculate(expression):
    """
    Safely calculate:
        +
        -
        *
        /
        %
        ()
    """

    expression = clean_expression(expression)

    if not expression:
        raise ValueError("Empty expression")

    try:
        tree = ast.parse(expression, mode="eval")
    except SyntaxError:
        raise ValueError(
            f"Invalid expression: {expression}"
        )

    def evaluate(node):

        if isinstance(node, ast.Expression):
            return evaluate(node.body)

        if isinstance(node, ast.Constant):

            if isinstance(node.value, (int, float)):
                return node.value

            raise ValueError("Invalid number")

        

        if isinstance(node, ast.BinOp):

            left = evaluate(node.left)
            right = evaluate(node.right)

            operation = OPERATORS.get(type(node.op))

            if operation is None:
                raise ValueError("Unsupported operator")

            if isinstance(node.op, ast.Div):

                if right == 0:
                    raise ZeroDivisionError(
                        "Cannot divide by zero"
                    )

            return operation(left, right)

        if isinstance(node, ast.UnaryOp):

            value = evaluate(node.operand)

            operation = OPERATORS.get(type(node.op))

            if operation is None:
                raise ValueError("Unsupported operator")

            return operation(value)

        raise ValueError("Invalid expression")

    return evaluate(tree)


# ============================================================
# OCR TEXT CLEANING
# ============================================================

def clean_expression(text):

    if not text:
        return ""

    # Convert everything to string
    text = str(text)

    # Remove newlines/tabs
    text = text.replace("\n", " ")
    text = text.replace("\r", " ")
    text = text.replace("\t", " ")

    text = text.strip()

    # --------------------------------------------------------
    # Common OCR mistakes
    # --------------------------------------------------------

    replacements = {

        # Multiplication
        "×": "*",
        "x": "*",
        "X": "*",
        "✕": "*",
        "✖️": "*",

        # Division
        "÷": "/",
        "∕": "/",

        # Minus
        "−": "-",
        "–": "-",
        "—": "-",
        "_": "-",

        # Decimal
        ",": ".",

        # OCR number mistakes
        "O": "0",
        "o": "0",

        "I": "1",
        "l": "1",
        "|": "1",

    }

    for old, new in replacements.items():
        text = text.replace(old, new)

    # --------------------------------------------------------
    # If OCR gives:
    #
    # 2 + 5 = 7
    #
    # only keep:
    #
    # 2 + 5
    # --------------------------------------------------------

    if "=" in text:
        text = text.split("=")[0]

    # --------------------------------------------------------
    # Remove spaces
    # --------------------------------------------------------

    text = re.sub(r"\s+", "", text)

    # --------------------------------------------------------
    # Keep only calculator characters
    # --------------------------------------------------------

    text = re.sub(
        r"[^0-9+\-*/%.()]",
        "",
        text
    )

    # --------------------------------------------------------
    # Fix multiple decimal points
    # --------------------------------------------------------

    text = re.sub(
        r"\.{2,}",
        ".",
        text
    )

    return text


# ============================================================
# CHECK EXPRESSION
# ============================================================

def is_valid_expression(expression):

    if not expression:
        return False

    # Must contain at least one digit
    if not re.search(r"\d", expression):
        return False

    # Must not start/end with an operator
    if expression.endswith(
        ("+", "-", "*", "/", "%")
    ):
        return False

    # Avoid obvious bad OCR
    if "**" in expression:
        return False

    try:
        calculate(expression)
        return True

    except Exception:
        return False


# ============================================================
# ROI
# ============================================================

def get_roi(frame):

    height, width = frame.shape[:2]

    # Large scanning area
    box_width = int(width * 0.82)
    box_height = int(height * 0.35)

    box_width = min(
        box_width,
        width - 40
    )

    box_height = min(
        box_height,
        height - 40
    )

    x1 = (width - box_width) // 2
    y1 = (height - box_height) // 2

    x2 = x1 + box_width
    y2 = y1 + box_height

    return x1, y1, x2, y2


# ============================================================
# CREATE OCR IMAGES
# ============================================================

def create_ocr_images(roi):

    gray = cv2.cvtColor(
        roi,
        cv2.COLOR_BGR2GRAY
    )

    # Increase size
    gray = cv2.resize(
        gray,
        None,
        fx=4,
        fy=4,
        interpolation=cv2.INTER_CUBIC
    )

    # Improve contrast
    gray = cv2.normalize(
        gray,
        None,
        0,
        255,
        cv2.NORM_MINMAX
    )

    # Slight blur
    blurred = cv2.GaussianBlur(
        gray,
        (3, 3),
        0
    )

    # --------------------------------------------------------
    # OTSU
    # --------------------------------------------------------

    _, otsu = cv2.threshold(
        blurred,
        0,
        255,
        cv2.THRESH_BINARY + cv2.THRESH_OTSU
    )

    # --------------------------------------------------------
    # Adaptive
    # --------------------------------------------------------

    adaptive = cv2.adaptiveThreshold(
        blurred,
        255,
        cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY,
        31,
        8
    )

    # --------------------------------------------------------
    # Inverted
    # --------------------------------------------------------

    inverted = cv2.bitwise_not(
        otsu
    )

    return [
        gray,
        otsu,
        adaptive,
        inverted
    ]


# ============================================================
# OCR
# ============================================================

def run_ocr(roi):

    images = create_ocr_images(
        roi
    )

    # --------------------------------------------------------
    # We try different PSM modes.
    #
    # PSM 7  = single line
    # PSM 6  = block of text
    # PSM 13 = raw single line
    # --------------------------------------------------------

    configs = [

        r"--psm 7 "
        r"-c tessedit_char_whitelist="
        r"0123456789+-*/xX×÷.()=",

        r"--psm 6 "
        r"-c tessedit_char_whitelist="
        r"0123456789+-*/xX×÷.()=",

        r"--psm 13 "
        r"-c tessedit_char_whitelist="
        r"0123456789+-*/xX×÷.()=",
    ]

    results = []

    for image in images:

        for config in configs:

            try:

                text = pytesseract.image_to_string(
                    image,
                    config=config
                )

                text = text.strip()

                if text:

                    results.append(text)

            except Exception:
                pass

    return results


# ============================================================
# FIND BEST EXPRESSION
# ============================================================

def find_expression(ocr_results):

    candidates = []

    for raw in ocr_results:

        cleaned = clean_expression(
            raw
        )

        if not cleaned:
            continue

        # Must have a digit
        if not re.search(
            r"\d",
            cleaned
        ):
            continue

        # Check whether calculator accepts it
        try:

            result = calculate(
                cleaned
            )

            # Prefer expressions containing an operator
            operator_count = len(
                re.findall(
                    r"[+\-*/%]",
                    cleaned
                )
            )

            candidates.append(
                (
                    operator_count,
                    len(cleaned),
                    cleaned,
                    result,
                    raw
                )
            )

        except Exception:
            continue

    if not candidates:
        return "", None, ""

    # --------------------------------------------------------
    # Prefer expressions with operators.
    # Then prefer a shorter clean expression.
    # --------------------------------------------------------

    candidates.sort(
        key=lambda x: (
            -x[0],
            x[1]
        )
    )

    best = candidates[0]

    return (
        best[2],
        best[3],
        best[4]
    )


# ============================================================
# FORMAT RESULT
# ============================================================

def format_result(result):

    if isinstance(
        result,
        float
    ):

        if result.is_integer():
            return str(
                int(result)
            )

        return f"{result:.10g}"

    return str(result)


# ============================================================
# CAMERA MODE
# ============================================================

def camera_mode():

    cap = cv2.VideoCapture(
        0,
        cv2.CAP_DSHOW
    )

    if not cap.isOpened():

        # Try again without CAP_DSHOW
        cap.release()

        cap = cv2.VideoCapture(
            0
        )

    if not cap.isOpened():

        print(
            "Could not open camera."
        )

        input(
            "Press ENTER..."
        )

        return

    # Camera resolution
    cap.set(
        cv2.CAP_PROP_FRAME_WIDTH,
        1280
    )

    cap.set(
        cv2.CAP_PROP_FRAME_HEIGHT,
        720
    )

    last_raw = ""
    last_expression = ""
    last_answer = ""

    status = (
        "Put expression inside GREEN box"
    )

    print()
    print("=" * 60)
    print("CAMERA CALCULATOR")
    print("=" * 60)

    print()
    print("Examples:")
    print("  1 + 1")
    print("  2 + 5")
    print("  8 x 3")
    print("  20 / 4")
    print("  (10 + 5) x 2")
    print()

    print(
        "SPACE = Scan"
    )

    print(
        "R = Reset"
    )

    print(
        "ESC = Exit"
    )

    print()

    while True:

        ret, frame = cap.read()

        if not ret:

            status = (
                "Could not read camera"
            )

            break

        # ----------------------------------------------------
        # IMPORTANT:
        #
        # No mirror transformation.
        # OCR receives the original frame.
        # ----------------------------------------------------

        original_frame = frame.copy()

        # ----------------------------------------------------
        # ROI
        # ----------------------------------------------------

        x1, y1, x2, y2 = get_roi(
            original_frame
        )

        display = original_frame.copy()

        # ----------------------------------------------------
        # Green box
        # ----------------------------------------------------

        cv2.rectangle(
            display,
            (x1, y1),
            (x2, y2),
            (0, 255, 0),
            3
        )

        # ----------------------------------------------------
        # Instructions
        # ----------------------------------------------------

        cv2.putText(
            display,
            "PUT MATH INSIDE GREEN BOX",
            (30, 40),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.75,
            (0, 255, 0),
            2
        )

        cv2.putText(
            display,
            "SPACE = SCAN | R = RESET | ESC = EXIT",
            (30, 75),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.60,
            (255, 255, 255),
            2
        )

        # ----------------------------------------------------
        # OCR result
        # ----------------------------------------------------

        if last_raw:

            cv2.putText(
                display,
                "OCR: " + last_raw,
                (30, display.shape[0] - 125),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (255, 255, 0),
                2
            )

        # ----------------------------------------------------
        # Expression
        # ----------------------------------------------------

        if last_expression:

            cv2.putText(
                display,
                "EXPRESSION: " + last_expression,
                (30, display.shape[0] - 90),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (255, 255, 0),
                2
            )

        # ----------------------------------------------------
        # Answer
        # ----------------------------------------------------

        if last_answer:

            cv2.putText(
                display,
                "ANSWER: " + last_answer,
                (30, display.shape[0] - 45),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.95,
                (0, 255, 0),
                3
            )

        else:

            cv2.putText(
                display,
                status,
                (30, display.shape[0] - 45),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (255, 255, 255),
                2
            )

        # ----------------------------------------------------
        # Display camera
        # ----------------------------------------------------

        cv2.imshow(
            "Camera Calculator",
            display
        )

        key = cv2.waitKey(1) & 0xFF

        # ----------------------------------------------------
        # ESC
        # ----------------------------------------------------

        if key == 27:

            break

        # ----------------------------------------------------
        # RESET
        # ----------------------------------------------------

        elif key in (
            ord("r"),
            ord("R")
        ):

            last_raw = ""
            last_expression = ""
            last_answer = ""

            status = (
                "Put expression inside GREEN box"
            )

        # ----------------------------------------------------
        # SPACE / SCAN
        # ----------------------------------------------------

        elif key == 32:

            print()
            print("=" * 60)
            print("SCANNING...")
            print("=" * 60)

            # Crop original image
            roi = original_frame[
                y1:y2,
                x1:x2
            ]

            status = "Scanning..."

            try:

                # OCR
                ocr_results = run_ocr(
                    roi
                )

                print()
                print("ALL OCR RESULTS:")

                for i, text in enumerate(
                    ocr_results,
                    start=1
                ):

                    print(
                        f"{i}: {repr(text)}"
                    )

                # ------------------------------------------------
                # Find best expression
                # ------------------------------------------------

                (
                    expression,
                    result,
                    raw
                ) = find_expression(
                    ocr_results
                )

                if expression:

                    answer = format_result(
                        result
                    )

                    last_raw = raw
                    last_expression = expression
                    last_answer = answer

                    status = (
                        "Solved successfully"
                    )

                    print()
                    print(
                        "SELECTED OCR:",
                        repr(raw)
                    )

                    print(
                        "EXPRESSION:",
                        expression
                    )

                    print(
                        "ANSWER:",
                        answer
                    )

                else:

                    last_raw = (
                        ocr_results[0]
                        if ocr_results
                        else "NOT DETECTED"
                    )

                    last_expression = ""
                    last_answer = ""

                    status = (
                        "Could not understand expression"
                    )

                    print()
                    print(
                        "No valid mathematical expression found."
                    )

            except Exception as error:

                last_raw = ""
                last_expression = ""
                last_answer = ""

                status = (
                    "Error while scanning"
                )

                print()
                print(
                    "ERROR:",
                    error
                )

    cap.release()

    cv2.destroyAllWindows()


# ============================================================
# MANUAL MODE
# ============================================================

def manual_mode():

    print()
    print("=" * 55)
    print("MANUAL CALCULATOR")
    print("=" * 55)

    print()
    print("Examples:")
    print("  1 + 1")
    print("  2 + 5")
    print("  8 * 3")
    print("  20 / 4")
    print("  (10 + 5) * 2")
    print()
    print("Type q to return.")
    print()

    while True:

        expression = input(
            ">> "
        ).strip()

        if expression.lower() == "q":

            return

        if not expression:

            continue

        try:

            result = calculate(
                expression
            )

            print(
                "=",
                format_result(result)
            )

        except Exception as error:

            print(
                "Error:",
                error
            )


# ============================================================
# MAIN MENU
# ============================================================

def main():

    while True:

        print()
        print("=" * 60)
        print("       CAMERA + MANUAL CALCULATOR")
        print("=" * 60)

        print()
        print("1. Camera Calculator")
        print("2. Manual Calculator")
        print("3. Exit")
        print()

        choice = input(
            "Choose option (1/2/3): "
        ).strip()

        if choice == "1":

            camera_mode()

        elif choice == "2":

            manual_mode()

        elif choice == "3":

            print(
                "Goodbye!"
            )

            break

        else:

            print(
                "Invalid choice."
            )


# ============================================================
# START PROGRAM
# ============================================================

if _name_ == "_main_":

    main()
